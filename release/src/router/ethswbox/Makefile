EXE = ethswbox

all:
	-cp -f prebuilt/$(EXE) $(EXE)
	-cp -f prebuilt/cl22 cl22

clean:
	rm -f $(INSTALLDIR)/bin/$(EXE)
	rm -f $(INSTALLDIR)/bin/cl22

